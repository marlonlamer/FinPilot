generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String
  date      DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Income {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  source    String
  date      DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Savings {
  id           Int      @id @default(autoincrement())
  name         String
  targetAmount Float
  currentAmount Float    @default(0)
  startDate    DateTime @default(now())
  targetDate   DateTime?

  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  history      String?
  transactions SavingsTransaction[]
}

model SavingsTransaction {
  id         Int      @id @default(autoincrement())
  savingsId  Int?
  savings    Savings? @relation(fields: [savingsId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  amount     Float
  type       String   // 'deposit' | 'withdraw'
  note       String?
  date       DateTime @default(now())

  @@index([userId])
  @@index([savingsId])
}

model Debt {
  id               Int       @id @default(autoincrement())
  name             String
  debtType         String
  originalAmount   Decimal
  remainingBalance Decimal
  minimumPayment   Decimal?
  dueDate          DateTime?
  paymentFrequency String?
  status           String    @default("active")
  notes            String?
  account          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId           Int
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Bill {
  id               Int       @id @default(autoincrement())
  name             String
  category         String
  amount           Decimal
  billingFrequency String    @default("monthly")
  nextBillingDate  DateTime?
  paymentMethod    String?
  autoPay          Boolean   @default(false)
  status           String    @default("active")
  notes            String?
  account          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId           Int
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model User {
  id        Int       @id @default(autoincrement())
  name      String   @default("")
  email     String    @unique
  password  String
  date      DateTime  @default(now())

  // new fields for budgets and available balance
  availableBalance Float @default(0)
  totalSavings Float @default(0)
  monthlyBudget Float @default(0)
  monthlySpent Float @default(0)
  monthlyBudgetRemaining Float @default(0)
  totalNetWorth Float @default(0)

  expenses  Expense[]
  income    Income[]
  savings   Savings[]
  savingsTransactions SavingsTransaction[]
  budgets   Budget[]
  debts     Debt[]
  bills     Bill[]
}

model Budget {
  id              Int      @id @default(autoincrement())
  userId          Int
  category        String
  budgetLimit     Float?
  budgetSpent     Float    @default(0)
  budgetRemaining Float    @default(0)
  month           String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@unique([userId, category, month])
}



