generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String
  date      DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Income {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  source    String
  date      DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Savings {
  id           Int      @id @default(autoincrement())
  name         String
  targetAmount Float
  currentAmount Float    @default(0)
  startDate    DateTime @default(now())
  targetDate   DateTime?

  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  history      String?
  transactions SavingsTransaction[]
}

model SavingsTransaction {
  id         Int      @id @default(autoincrement())
  savingsId  Int?
  savings    Savings? @relation(fields: [savingsId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  amount     Float
  type       String   // 'deposit' | 'withdraw'
  note       String?
  date       DateTime @default(now())

  @@index([userId])
  @@index([savingsId])
}

model User {
  id        Int       @id @default(autoincrement())
  name      String   @default("")
  email     String    @unique
  password  String
  date      DateTime  @default(now())

  // new fields for budgets and available balance
  availableBalance Float @default(0)
  totalSavings Float @default(0)
  monthlyBudget Float @default(0)
  monthlySpent Float @default(0)
  monthlyBudgetRemaining Float @default(0)
  totalNetWorth Float @default(0)

  expenses  Expense[]
  income    Income[]
  savings   Savings[]
  savingsTransactions SavingsTransaction[]
  budgets   Budget[]
}

model Budget {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Float
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@unique([userId, category])
}



